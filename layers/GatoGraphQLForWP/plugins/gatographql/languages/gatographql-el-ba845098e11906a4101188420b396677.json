03bc\u03ad\u03bd\u03bf \u03ae \u03b1\u03b4\u03b7\u03bc\u03bf\u03c3\u03af\u03b5\u03c5\u03c4\u03bf \u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af\u03bf \u03bc\u03b5 ID '%s')"],"(none selected)":["(\u03ba\u03b1\u03bc\u03af\u03b1 \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae)"],"Default (use value defined in the Settings page)":["\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae (\u03c7\u03c1\u03ae\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03c4\u03b9\u03bc\u03ae\u03c2 \u03c0\u03bf\u03c5 \u03bf\u03c1\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1 \u03a1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03c9\u03bd)"],"Undefined elements":["\u039c\u03b7 \u03bf\u03c1\u03b9\u03c3\u03bc\u03ad\u03bd\u03b1 \u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af\u03b1"],"Hide search":["\u0391\u03c0\u03cc\u03ba\u03c1\u03c5\u03c8\u03b7 \u03b1\u03bd\u03b1\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7\u03c2"],"Show search":["\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03b1\u03bd\u03b1\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7\u03c2"],"Search":["\u0391\u03bd\u03b1\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7"],"Available items":["\u0394\u03b9\u03b1\u03b8\u03ad\u03c3\u03b9\u03bc\u03b1 \u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af\u03b1"],"No items found.":["\u0394\u03b5\u03bd \u03b2\u03c1\u03ad\u03b8\u03b7\u03ba\u03b1\u03bd \u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af\u03b1."],"Operations":["\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2"],"Global Fields":["\u039a\u03b1\u03b8\u03bf\u03bb\u03b9\u03ba\u03ac \u03a0\u03b5\u03b4\u03af\u03b1"],"Directives":["\u039f\u03b4\u03b7\u03b3\u03af\u03b5\u03c2"],"(Undefined entries)":["(\u039c\u03b7 \u03bf\u03c1\u03b9\u03c3\u03bc\u03ad\u03bd\u03b5\u03c2 \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ad\u03c2)"],"Fields":["\u03a0\u03b5\u03b4\u03af\u03b1"],"Default":["\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae"],"GraphQL Spec Compliance":["\u03a3\u03c5\u03bc\u03bc\u03cc\u03c1\u03c6\u03c9\u03c3\u03b7 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b4\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae GraphQL"],"Pass a null up to the nearest nullable parent?":["\u039c\u03b5\u03c4\u03b1\u03b2\u03af\u03b2\u03b1\u03c3\u03b7 \u03b5\u03bd\u03cc\u03c2 null \u03c3\u03c4\u03bf\u03bd \u03c0\u03bb\u03b7\u03c3\u03b9\u03ad\u03c3\u03c4\u03b5\u03c1\u03bf \u03b3\u03bf\u03bd\u03ad\u03b1 \u03c0\u03bf\u03c5 \u03b4\u03ad\u03c7\u03b5\u03c4\u03b1\u03b9 null;"],"When a non-null field is null, pass the null up to its nearest nullable parent (or to \"data\")":["\u038c\u03c4\u03b1\u03bd \u03ad\u03bd\u03b1 \u03c0\u03b5\u03b4\u03af\u03bf \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03b5\u03c0\u03b9\u03c4\u03c1\u03ad\u03c0\u03b5\u03b9 null \u03b5\u03af\u03bd\u03b1\u03b9 null, \u03bc\u03b5\u03c4\u03ac\u03b4\u03bf\u03c3\u03b7 \u03c4\u03bf\u03c5 null \u03c3\u03c4\u03bf\u03bd \u03c0\u03bb\u03b7\u03c3\u03b9\u03ad\u03c3\u03c4\u03b5\u03c1\u03bf \u03b3\u03bf\u03bd\u03ad\u03b1 \u03c0\u03bf\u03c5 \u03b5\u03c0\u03b9\u03c4\u03c1\u03ad\u03c0\u03b5\u03b9 null (\u03ae \u03c3\u03c4\u03bf \"data\")"],"Pass the null up":["\u039c\u03b5\u03c4\u03ac\u03b4\u03bf\u03c3\u03b7 \u03c4\u03bf\u03c5 null \u03c0\u03c1\u03bf\u03c2 \u03c4\u03b1 \u03c0\u03ac\u03bd\u03c9"],"Print the field as null":["\u0395\u03ba\u03c4\u03cd\u03c0\u03c9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c0\u03b5\u03b4\u03af\u03bf\u03c5 \u03c9\u03c2 null"],"Coerce scalar and enum values?":["\u0395\u03be\u03b1\u03bd\u03b1\u03b3\u03ba\u03b1\u03c3\u03bc\u03cc\u03c2 (coercion) \u03c4\u03b9\u03bc\u03ce\u03bd scalar \u03ba\u03b1\u03b9 enum;"],"Coerce the values of the built-in scalars and of enums to their type (eg: print an ID as a string)":["\u039c\u03b5\u03c4\u03b1\u03c4\u03c1\u03bf\u03c0\u03ae \u03c4\u03c9\u03bd \u03c4\u03b9\u03bc\u03ce\u03bd \u03c4\u03c9\u03bd \u03b5\u03bd\u03c3\u03c9\u03bc\u03b1\u03c4\u03c9\u03bc\u03ad\u03bd\u03c9\u03bd scalars \u03ba\u03b1\u03b9 \u03c4\u03c9\u03bd enums \u03c3\u03c4\u03bf\u03bd \u03c4\u03cd\u03c0\u03bf \u03c4\u03bf\u03c5\u03c2 (\u03c0.\u03c7. \u03b5\u03ba\u03c4\u03cd\u03c0\u03c9\u03c3\u03b7 \u03b5\u03bd\u03cc\u03c2 ID \u03c9\u03c2 string)"],"Coerce the values":["\u039c\u03b5\u03c4\u03b1\u03c4\u03c1\u03bf\u03c0\u03ae \u03c4\u03c9\u03bd \u03c4\u03b9\u03bc\u03ce\u03bd"],"Print the values as they are":["\u0395\u03ba\u03c4\u03cd\u03c0\u03c9\u03c3\u03b7 \u03c4\u03c9\u03bd \u03c4\u03b9\u03bc\u03ce\u03bd \u03cc\u03c0\u03c9\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9"],"Add the response path to errors?":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03c4\u03b7\u03c2 \u03b4\u03b9\u03b1\u03b4\u03c1\u03bf\u03bc\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03b1\u03c0\u03cc\u03ba\u03c1\u03b9\u03c3\u03b7\u03c2 \u03c3\u03c4\u03b1 \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03b1;"],"Add entry \"path\" to every error, with its position in the response":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03c4\u03b7\u03c2 \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae\u03c2 \"path\" \u03c3\u03b5 \u03ba\u03ac\u03b8\u03b5 \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1, \u03bc\u03b5 \u03c4\u03b7 \u03b8\u03ad\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b7\u03bd \u03b1\u03c0\u03cc\u03ba\u03c1\u03b9\u03c3\u03b7"],"Add the response path":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03c4\u03b7\u03c2 \u03b4\u03b9\u03b1\u03b4\u03c1\u03bf\u03bc\u03ae\u03c2 \u03c3\u03c4\u03b7\u03bd \u03b1\u03c0\u03cc\u03ba\u03c1\u03b9\u03c3\u03b7"],"Do not add the response path":["\u039d\u03b1 \u03bc\u03b7\u03bd \u03c0\u03c1\u03bf\u03c3\u03c4\u03b5\u03b8\u03b5\u03af \u03b7 \u03b4\u03b9\u03b1\u03b4\u03c1\u03bf\u03bc\u03ae \u03c3\u03c4\u03b7\u03bd \u03b1\u03c0\u03cc\u03ba\u03c1\u03b9\u03c3\u03b7"],"Return no data on request errors?":["\u039d\u03b1 \u03bc\u03b7\u03bd \u03b5\u03c0\u03b9\u03c3\u03c4\u03c1\u03ad\u03c6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03cc\u03c4\u03b1\u03bd \u03c5\u03c0\u03ac\u03c1\u03c7\u03bf\u03c5\u03bd \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03b1 \u03c3\u03c4\u03bf \u03b1\u03af\u03c4\u03b7\u03bc\u03b1;"],"Validate the query before executing it and, if it has errors, return the errors only, without \"data\"":["\u0395\u03c0\u03b9\u03ba\u03cd\u03c1\u03c9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03b5\u03c1\u03c9\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c0\u03c1\u03b9\u03bd \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03b5\u03ba\u03c4\u03ad\u03bb\u03b5\u03c3\u03ae \u03c4\u03bf\u03c5 \u03ba\u03b1\u03b9, \u03b1\u03bd \u03ad\u03c7\u03b5\u03b9 \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03b1, \u03b5\u03c0\u03b9\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u03bc\u03cc\u03bd\u03bf \u03c4\u03c9\u03bd \u03c3\u03c6\u03b1\u03bb\u03bc\u03ac\u03c4\u03c9\u03bd, \u03c7\u03c9\u03c1\u03af\u03c2 \"data\""],"Return no data":["\u039d\u03b1 \u03bc\u03b7\u03bd \u03b5\u03c0\u03b9\u03c3\u03c4\u03c1\u03b1\u03c6\u03bf\u03cd\u03bd \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1"],"Resolve the valid fields":["\u0395\u03c0\u03af\u03bb\u03c5\u03c3\u03b7 \u03c4\u03c9\u03bd \u03ad\u03b3\u03ba\u03c5\u03c1\u03c9\u03bd \u03c0\u03b5\u03b4\u03af\u03c9\u03bd"],"Follow the GraphQL spec where Gato GraphQL behaves differently, in the Schema Configuration":["\u0391\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03ae\u03c3\u03c4\u03b5 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b4\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae GraphQL \u03b5\u03ba\u03b5\u03af \u03cc\u03c0\u03bf\u03c5 \u03c4\u03bf Gato GraphQL \u03c3\u03c5\u03bc\u03c0\u03b5\u03c1\u03b9\u03c6\u03ad\u03c1\u03b5\u03c4\u03b1\u03b9 \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03b5\u03c4\u03b9\u03ba\u03ac, \u03c3\u03c4\u03b7 \u0394\u03b9\u03b1\u03bc\u03cc\u03c1\u03c6\u03c9\u03c3\u03b7 \u03a3\u03c7\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2"]}}}